{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    // `~` is `src/`, as in the api: `~/utils/api`.
    // `@sync-app/shared` is the types the client shares with the api, imported with `import type` only.
    "paths": {
      "~/*": ["./src/*"],
      "@sync-app/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", ".react-router/types/**/*"],
  "exclude": ["node_modules", ".build"]
}
